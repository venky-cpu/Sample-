### 4. Service — the core logic (using the new Java `ElasticsearchClient` 8.x)

```java
@Service
@RequiredArgsConstructor
@Slf4j
public class ProductSearchService {

    private final ElasticsearchClient esClient;

    private static final String INDEX = "products";
    private static final Time PIT_KEEP_ALIVE = Time.of(t -> t.time("2m"));

    public PagedResult<Product> search(SearchRequest req) throws IOException {

        // 1. Resolve PIT: reuse from cursor, or open a fresh one
        String pitId = (req.cursor() != null)
                ? SearchCursor.decode(req.cursor()).pitId()
                : openPit();

        List<Object> searchAfter = (req.cursor() != null)
                ? SearchCursor.decode(req.cursor()).sortValues()
                : null;

        // 2. Build the query
        SearchRequest.Builder<Product> builder = new co.elastic.clients.elasticsearch.core
                .SearchRequest.Builder();

        var esRequest = co.elastic.clients.elasticsearch.core.SearchRequest.of(s -> {
            s.pit(p -> p.id(pitId).keepAlive(PIT_KEEP_ALIVE))
             .size(req.pageSize())
             .query(q -> buildQuery(q, req.query()))
             // deterministic sort + tiebreaker — CRITICAL
             .sort(so -> so.field(f -> f.field("createdAt").order(SortOrder.Desc)))
             .sort(so -> so.field(f -> f.field("_id").order(SortOrder.Asc)));

            if (searchAfter != null && !searchAfter.isEmpty()) {
                s.searchAfter(searchAfter.stream()
                        .map(v -> FieldValue.of(v.toString()))
                        .toList());
            }
            return s;
        });

        // 3. Execute
        SearchResponse<Product> resp = esClient.search(esRequest, Product.class);
        List<Hit<Product>> hits = resp.hits().hits();

        // 4. Build the response
        List<Product> items = hits.stream()
                .map(Hit::source)
                .toList();

        boolean hasMore = hits.size() == req.pageSize();
        String nextCursor = null;

        if (hasMore) {
            List<Object> lastSort = hits.get(hits.size() - 1).sort().stream()
                    .map(FieldValue::_get)
                    .toList();
            // PIT id can change; use the one ES returns
            nextCursor = new SearchCursor(resp.pitId(), lastSort).encode();
        } else {
            closePit(pitId); // exhausted — clean up
        }

        return new PagedResult<>(items, nextCursor, hasMore);
    }

    private ObjectBuilder<Query> buildQuery(Query.Builder q, String text) {
        if (text == null || text.isBlank()) {
            return q.matchAll(m -> m);
        }
        return q.multiMatch(m -> m
                .query(text)
                .fields("name^3", "description", "tags"));
    }

    private String openPit() throws IOException {
        return esClient.openPointInTime(p -> p
                .index(INDEX)
                .keepAlive(PIT_KEEP_ALIVE)).id();
    }

    private void closePit(String pitId) {
        try {
            esClient.closePointInTime(c -> c.id(pitId));
        } catch (IOException e) {
            log.warn("Failed to close PIT {}, will expire via keepAlive", pitId, e);
        }
    }
}
```

### 5. Controller

```java
@RestController
@RequestMapping("/api/v1/products")
@RequiredArgsConstructor
public class ProductSearchController {

    private final ProductSearchService searchService;

    @GetMapping("/search")
    public PagedResult<Product> search(
            @RequestParam(required = false) String query,
            @RequestParam(defaultValue = "20") @Min(1) @Max(100) int pageSize,
            @RequestParam(required = false) String cursor) throws IOException {

        return searchService.search(new SearchRequest(query, pageSize, cursor));
    }
}
```

### 6. Exception handling

```java
@RestControllerAdvice
public class SearchExceptionHandler {

    @ExceptionHandler(InvalidCursorException.class)
    public ResponseEntity<ApiError> handleBadCursor(InvalidCursorException e) {
        return ResponseEntity.badRequest()
                .body(new ApiError("INVALID_CURSOR", e.getMessage()));
    }

    @ExceptionHandler(ElasticsearchException.class)
    public ResponseEntity<ApiError> handleEs(ElasticsearchException e) {
        // PIT expired → 410 Gone tells client to restart from page 1
        if (e.getMessage() != null && e.getMessage().contains("search_context_missing")) {
            return ResponseEntity.status(HttpStatus.GONE)
                    .body(new ApiError("CURSOR_EXPIRED", "Restart pagination"));
        }
        throw e;
    }
}
```

